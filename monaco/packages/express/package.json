{
  "name": "swagger-ui-monaco-express",
  "version": "0.1.0-beta.1",
  "description": "Express middleware for Swagger UI with Monaco request editors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ariel1safar/swagger-ui-monaco.git",
    "directory": "monaco/packages/express"
  },
  "homepage": "https://github.com/ariel1safar/swagger-ui-monaco/tree/main/monaco/packages/express#readme",
  "bugs": {"url": "https://github.com/ariel1safar/swagger-ui-monaco/issues"},
  "keywords": ["swagger-ui", "monaco-editor", "openapi", "express", "middleware"],
  "scripts": {"prepack": "node --experimental-strip-types ../../scripts/check-package.ts"},
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "swagger-ui-express": "5.0.1",
    "swagger-ui-monaco-dist": "0.1.0-beta.1",
    "@types/swagger-ui-express": "4.1.8"
  },
  "peerDependencies": {
    "express": "^4.21.2 || ^5.0.0"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
